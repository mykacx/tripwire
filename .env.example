# PayPal sandbox app credentials (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Same client ID, exposed to the browser for the PayPal JS SDK buttons
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# Anthropic API key for the AI risk review
ANTHROPIC_API_KEY=

# Optional: free alternative to Anthropic for the AI review (used only if ANTHROPIC_API_KEY is empty).
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Default tries gemini-3.8-flash, then gemini-3.5-flash-lite. Uncomment to pin one model:
# GEMINI_MODEL=gemini-3.5-flash-lite
